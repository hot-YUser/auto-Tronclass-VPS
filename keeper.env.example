QR_BASE=https://www.tronclass.com.tw
QR_COURSE_ID=<replace-with-course-id>
QR_TEACHER_USER=<replace-with-teacher-email>
QR_TEACHER_PASS=<replace-with-teacher-password>
QR_SOURCE_REVISION=<40-char-public-commit-sha>
QR_WORKDIR=/home/opc/qr-harvest

QR_POLL_SECONDS=0.5
QR_PASSIVE_CHECK_SECONDS=5
QR_STATE_WRITE_SECONDS=5
QR_COOKIE_RESAVE_SECONDS=300
QR_SOCKET_TIMEOUT_SECONDS=20

# Keeper validates again immediately before writing token.json.
QR_STALE_MS=3000
QR_FUTURE_SKEW_MS=1000

# Optional sensitive token corpus. Disabled by default; enabling stores raw tokens on disk.
QR_CORPUS_ENABLED=false
QR_CORPUS_MAX_BYTES=16106127360
QR_CORPUS_MAX_DAYS=30
QR_CORPUS_MIN_FREE_BYTES=5368709120
QR_CORPUS_FLUSH_RECORDS=20

# on, off, or auto. Auto requires a valid UTC date.
QR_PRESERVE_MODE=auto
QR_PRESERVE_AFTER=2026-08-31

# Optional positive integer. Empty uses the server-safe duration ladder.
QR_ROLLCALL_DURATION_SECONDS=
