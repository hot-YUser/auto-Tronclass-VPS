[Unit]
Description=TronClass QR data read-only API (decoupled from keeper)
After=network-online.target qr-keeper.service
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/qr-harvest
EnvironmentFile=/etc/qr-harvest/api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/opc/qr-harvest/qr_api.py
UMask=0077
NoNewPrivileges=true
TasksMax=64
MemoryMax=256M
LimitNOFILE=1024
TimeoutStopSec=30
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
