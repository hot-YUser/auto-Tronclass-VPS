# Shared non-secret configuration loaded by both services.
# Changes here affect keeper and API together; authoritative — common.env loads LAST and wins.
# Secret env files (api.env / keeper.env) remain disjoint and never share a combined file.
# Rolling deploy note: if common.env is absent, services fall back to values in api.env/keeper.env;
# after common.env is installed, its values deterministically override service-specific copies.
QR_WORKDIR=/home/opc/qr-harvest
QR_SOURCE_REVISION=<40-char-public-commit-sha>
QR_STALE_MS=3000
QR_FUTURE_SKEW_MS=1000
