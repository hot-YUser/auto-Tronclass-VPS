# Optional master/admin key (minimum 32 characters). Leave empty to accept managed keys only.
QR_API_KEY=
QR_BIND=127.0.0.1
QR_PORT=8741

# Shared non-secret settings live in common.env (QR_WORKDIR/QR_SOURCE_REVISION/QR_STALE_MS/QR_FUTURE_SKEW_MS).
# Previous releases had these in api.env; copy any overrides into common.env before switching.

# Fixed concurrency and accepted-socket timeout.
QR_API_WORKERS=4
QR_API_PENDING=16
QR_SOCKET_TIMEOUT_SECONDS=10

# Monotonic token buckets. Per-principal 2 req/s keeps 1 req/s clients compatible.
QR_LIMITER_MAX_ENTRIES=1024
QR_GLOBAL_RATE=20
QR_GLOBAL_BURST=40
QR_PRINCIPAL_RATE=2
QR_PRINCIPAL_BURST=4
QR_HEALTH_RATE=5
QR_HEALTH_BURST=10
QR_RESTART_RATE=0.0166666667
QR_RESTART_BURST=1
