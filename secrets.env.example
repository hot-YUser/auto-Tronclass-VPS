QR_BASE=https://www.tronclass.com.tw
QR_COURSE_ID=55379
QR_TEACHER_USER=<老師帳號 email>
QR_TEACHER_PASS=<密碼>
QR_STUDENT_USER=<學生帳號 email>
QR_STUDENT_PASS=<密碼>
# master/admin key（選用）：可用於 /token 與 /restart。實際對外發放請用 qr_keys.py 建立
# 有 TTL、可即時撤銷的受管 key（存 apikeys.json）。此 master key 請自己留著、勿外發。
QR_API_KEY=<openssl rand -hex 24>
QR_BIND=127.0.0.1
QR_PORT=8741
QR_POLL_SECONDS=0.5
QR_STALE_MS=3000
QR_WORKDIR=/home/opc/qr-harvest

# --- 8/31 撤銷後保命模式（keeper 讀）---
# on   = 立即啟用；off = 永不啟用；auto = 到 QR_PRESERVE_AFTER（UTC 日期）自動啟用
# 啟用後：絕不 login（不驗證/不重登）、不刪 cookie，但仍以凍結的 cookie 建立/輪詢點名
#         （點名約 2h 伺服器自動結束，續命必須能重建）。賭「已登入 cookie 仍被伺服器接受」。
#         務必在 8/31 前先以 normal 模式跑到 cookies.txt 落地，auto 才有 cookie 可續。
QR_PRESERVE_MODE=auto
QR_PRESERVE_AFTER=2026-08-25

# --- 選用微調（省略即用預設）---
# 單一長效點名的 duration（秒）。省略＝每次建場動態算「到 9999-01-01」＝伺服器上限（end_time
# 卡 9999 年天花板，約 7978 年）。設正整數可覆寫。實際 end_time 看 /health 的 rollcall_finished_at。
# QR_ROLLCALL_DURATION_SECONDS=
# QR_SELFTEST_SECONDS=3600
# QR_LOGINPROBE_SECONDS=21600
# QR_STATE_WRITE_SECONDS=5
# QR_COOKIE_RESAVE_SECONDS=300
